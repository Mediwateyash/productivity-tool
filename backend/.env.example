# Server Configuration
PORT=5000
NODE_ENV=development

# Database Settings
# Uncomment to use your custom MongoDB Atlas Cloud Cluster.
# If omitted or offline, DY Productivity Tool will gracefully fall back to Local JSON Files storage!
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dy_productivity?retryWrites=true&w=majority

# Security Keys
JWT_SECRET=dy_productivity_tool_super_secure_secret_hash_key_2026

# AI Engine Options
# Provide your Gemini API key to activate premium neural automation and workload summaries.
# If left blank, DY Productivity Tool falls back to a highly polished smart NLP offline rule-engine!
# GEMINI_API_KEY=your_gemini_api_key_here
